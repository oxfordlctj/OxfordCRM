# Строка подключения к PostgreSQL (Supabase / Neon / локальный)
DATABASE_URL=postgres://board:board@localhost:5432/board

# Ключ Claude API: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Модель (по умолчанию claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# Пароль для входа на платформу
APP_PASSWORD=change-me

# Секрет для подписи сессии: любая длинная случайная строка (openssl rand -hex 32)
AUTH_SECRET=

# 1 = тестовый режим без обращения к Claude (ответы-заглушки)
CLAUDE_MOCK=0
